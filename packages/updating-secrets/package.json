{
    "name": "updating-secrets",
    "version": "1.0.3",
    "description": "Automatically update secrets on an interval with support for seamless secret rotation.",
    "keywords": [
        "secrets",
        "rotation",
        "interval",
        "update"
    ],
    "homepage": "https://github.com/electrovir/updating-secrets",
    "bugs": {
        "url": "https://github.com/electrovir/updating-secrets/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/updating-secrets.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "tsx src/index.ts",
        "test": "virmator test node",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.33.1",
        "@augment-vir/common": "^31.33.1",
        "date-vir": "^7.4.2",
        "object-shape-tester": "^6.2.1",
        "type-fest": "^4.41.0"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.33.1",
        "@types/node": "^24.3.0",
        "c8": "^10.1.3",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "typedoc": "^0.28.12",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=22"
    }
}
